        {"value": "Diğer", "label": "Diğer"}
      ]},
    {"name": "explanation", "label": "Açıklama", "type": "textarea", "required": true, "placeholder": "Erteleme talebinizin gerekçesini detaylı yazın"},
    {"name": "city", "label": "Dilekçenin Yazıldığı Şehir", "type": "text", "required": true, "placeholder": "Örn: İstanbul"}
  ],
  "clauses": [
    {"title": "", "template": "{authority}'NA\n\n{city}, {bugun_tarihi}\n\nAdım Soyadım: {applicant_name}\nT.C. Kimlik No: {applicant_tc}\nAdresim: {applicant_address}\n\n{explanation}\n\nYukarıda belirttiğim {postponement_reason} nedeniyle askerlik hizmetimin ertelenmesini talep ediyorum. Gereğini saygılarımla arz ederim.\n\n{applicant_name}\nİmza"}
  ]
