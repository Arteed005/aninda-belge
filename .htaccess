Options -Indexes

RewriteEngine On

RewriteRule ^sitemap\.xml$ sitemap.php [L]

RewriteCond %{HTTP_HOST} ^(www\.)?anindabelge\.com$ [NC]
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} ^www\.anindabelge\.com$ [NC]
RewriteRule ^ https://anindabelge.com%{REQUEST_URI} [L,R=301,NE]

RewriteRule ^(lib|templates|config|sql|cron|storage|vendor|_gelistirme)/ - [F,L]
RewriteRule ^admin/_ - [F,L]

<FilesMatch "\.(json|sql|phar|lock|md|dc\.html|txt)$">
  Require all denied
</FilesMatch>

<Files "robots.txt">
  Require all granted
</Files>

<FilesMatch "^composer\.(json|lock)$">
  Require all denied
</FilesMatch>

ErrorDocument 404 /404.php

<IfModule mod_headers.c>
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains" env=HTTPS
  <FilesMatch "\.js$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType application/javascript "access plus 1 month"
  ExpiresByType text/javascript "access plus 1 month"
</IfModule>
